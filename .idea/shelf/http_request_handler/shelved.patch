         public void channelUnregistered(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\"initializeClientHandler.ClientLifecycleHandler: Channel unregistered: {}\",\n                                ctx.channel());\n                        super.channelUnregistered(ctx);\n                    }\n\n                    @Override\n                    public void channelActive(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\n                                \"initializeClientHandler.ClientLifecycleHandler: Channel active: {}. Sending initial ResourceUpdateMessage.\",\n                                ctx.channel());\n                        ctx.channel().writeAndFlush(new ResourceUpdateMessage(getAllResource()));\n                        logger.debug(\n                                \"initializeClientHandler.ClientLifecycleHandler: Sent ResourceUpdateMessage with resources: {}\",\n                                getAllResource());\n                        super.channelActive(ctx);\n                    }\n\n                    @Override\n                    public void channelInactive(ChannelHandlerContext ctx) throws Exception {\n                        logger.warn(\n                                \"initializeClientHandler.ClientLifecycleHandler: Channel inactive (connection to broker lost): {}. Shutting down taskExecutor.\",\n                                ctx.channel());\n                        taskExecutor.shutdownNow();\n                        taskExecutor = Executors.newSingleThreadExecutor();\n                        logger.debug(\n                                \"initializeClientHandler.ClientLifecycleHandler: taskExecutor shut down and re-initialized.\");\n                        if (distributor != null && distributor.getBrokerTier() != 0) {\n                            logger.warn(\n                                    \"initializeClientHandler.ClientLifecycleHandler: Interrupting distributeThread as this node was a sub-broker. Distributor tier: {}\",\n                                    distributor.getBrokerTier());\n                            distributeThread.interrupt();\n                        }\n                        super.channelInactive(ctx);\n                    }\n\n                    @Override\n                    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                        logger.error(\n                                \"initializeClientHandler.ClientLifecycleHandler: Exception caught in pipeline for channel {}: {}\",\n                                ctx.channel(), cause.getMessage(), cause);\n                        ctx.close();\n                    }\n                });\n\n                channel.pipeline().addLast(\"TaskStartMessageHandler\",\n                        new SimpleChannelInboundHandler<TaskStartMessage>() {\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, TaskStartMessage msg) {\n                                logger.debug(\n                                        \"initializeClientHandler.TaskStartMessageHandler: Received TaskStartMessage from {}: RequestId: {}, TaskInfo: {}\",\n                                        ctx.channel().remoteAddress(), msg.getRequestId(), msg.getTaskInformation());\n                                if (network.getClients().isEmpty()) { // This node is a worker\n                                    logger.debug(\n                                            \"initializeClientHandler.TaskStartMessageHandler: This node is a worker (no clients). Submitting task for execution. RequestId: {}\",\n                                            msg.getRequestId());\n                                    taskExecutor.submit(\n                                            () -> {\n                                                Map<String, Object> taskInformationMap = msg.getTaskInformation();\n                                                // 轉換為 TaskAssignment 以獲得類型安全\n                                                TaskAssignment taskAssignment = mapToTaskAssignment(taskInformationMap);\n\n                                                String requestName = taskAssignment.getRequestName();\n                                                String serviceName = taskAssignment.getServiceName();\n                                                int tier = taskAssignment.getTier();\n                                                logger.debug(\n                                                        \"initializeClientHandler.TaskStartMessageHandler.executor: Starting task execution. RequestName: {}, ServiceName: {}, Tier: {}\",\n                                                        requestName, serviceName, tier);\n\n                                                logger.info(\"start task : {}, service : {}\", requestName, serviceName);\n                                                HiBAService service = getService(serviceName);\n                                                if (service == null) {\n                                                    logger.error(\n                                                            \"initializeClientHandler.TaskStartMessageHandler.executor: Service {} not found for task {}. Cannot execute.\",\n                                                            serviceName, requestName);\n                                                    return;\n                                                }\n                                                Executor executor = service.getExecutor();\n                                                // 向後兼容，將 TaskAssignment 轉換為 Map 傳給 Executor\n                                                Map<String, Object> executorTaskMap = taskAssignmentToMap(\n                                                        taskAssignment);\n                                                executor.setTaskInformation(executorTaskMap);\n                                                executor.setTier(tier);\n\n                                                Map<String, Object> taskResult = executor.execute(executorTaskMap,\n                                                        ctx.channel());\n                                                logger.info(\"end task : {}, service : {}\", requestName, serviceName);\n                                                logger.debug(\n                                                        \"initializeClientHandler.TaskStartMessageHandler.executor: Task execution finished. RequestName: {}, ServiceName: {}. Result: {}\",\n                                                        requestName, serviceName, taskResult);\n                                                logger.debug(\n                                                        \"initializeClientHandler.TaskStartMessageHandler.executor: Sending TaskFinishMessage to {}. RequestName: {}\",\n                                                        ctx.channel().remoteAddress(), requestName);\n                                                ctx.channel().writeAndFlush(new TaskFinishMessage(taskResult));\n                                            }\n                                    );\n                                } else { // This node is a sub-broker\n                                    logger.debug(\n                                            \"initializeClientHandler.TaskStartMessageHandler: This node is a sub-broker (has clients). Offering task to requestQueue. RequestId: {}\",\n                                            msg.getRequestId());\n                                    boolean isOffer = requestQueue.offer(msg.getTaskInformation());\n                                    if (MulticastController.getMode().equals(\"isBroker\")) {\n                                        logger.debug(\n                                                \"initializeClientHandler.TaskStartMessageHandler: Node mode isBroker. Storing channel in upperBrokerRequestResultWaiterList for RequestId: {}\",\n                                                msg.getRequestId());\n                                        upperBrokerRequestResultWaiterList.put(msg.getRequestId(), ctx.channel());\n                                    }\n                                    if (!isOffer) {\n                                        logger.error(\"Queue is full!\");\n                                        logger.error(\n                                                \"initializeClientHandler.TaskStartMessageHandler: RequestQueue is full. Cannot add task for RequestId: {}\",\n                                                msg.getRequestId());\n                                    }\n                                }\n                            }\n\n                            @Override\n                            public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                                logger.error(\n                                        \"initializeClientHandler.TaskStartMessageHandler: Exception caught for channel {}: {}\",\n                                        ctx.channel(), cause.getMessage(), cause);\n                                ctx.close();\n                            }\n                        });\n                logger.debug(\"initializeClientHandler.initial: Client channel pipeline initialized for Channel ID: {}\",\n                        channel.id());\n            }\n        };\n    }\n\n    public App addService(HiBAService service) {\n        serviceList.put(service.getName(), service);\n        return this;\n    }\n\n    public void updateResource() {\n        if (network.getBrokerChannel() != null) {\n            network.getBrokerChannel().writeAndFlush(new ResourceUpdateMessage(getAllResource()));\n        }\n    }\n\n    public App setResource(Map<String, Object> resource) {\n        this.localResource = resource;\n        return this;\n    }\n\n    public void sendRequest(Map<String, Object> request) throws Exception {\n        // 轉換為 TaskRequest 以獲得類型安全\n        TaskRequest taskRequest = mapToTaskRequest(request);\n\n        String requestName = taskRequest.getRequestName();\n        String serviceName = taskRequest.getServiceName();\n        logger.debug(\"sendRequest: Entry. RequestName: {}, ServiceName: {}\", requestName, serviceName);\n        logger.debug(\"sendRequest: Full request map: {}\", request);\n\n        HiBAService service = getService(serviceName);\n        if (service == null) {\n            logger.error(\"sendRequest: Service '{}' not found. RequestName: {}\", serviceName, requestName);\n            TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n            failureResult.setState(false);\n            failureResult.setSuccess(false);\n            failureResult.setErrorMessage(\"Service not found: \" + serviceName);\n            outputResponse(requestName, taskResultToMap(failureResult));\n            return;\n        }\n\n        boolean hasBroker = !(network.getBrokerChannel() == null);\n        logger.debug(\"sendRequest: Has upstream broker? {}. RequestName: {}\", hasBroker, requestName);\n\n        Taker taker = service.getTaker();\n        taker.setRequestInformation(taskRequestToMap(taskRequest));\n\n        boolean canHandleLocally = taker.checkCanHandleRequest(hasBroker, getAllResource());\n        logger.debug(\"sendRequest: Taker canHandleRequest? {}. RequestName: {}\", canHandleLocally, requestName);\n\n        if (!network.getClients().isEmpty() && canHandleLocally) {\n            logger.debug(\"sendRequest: Handling request locally. RequestName: {}\", requestName);\n\n            if (taskRequest.hasTransferFile()) {\n                String receiveTransferFile = taskRequest.getReceiveTargetPath();\n                List<String> transferFile = taskRequest.getTransferFileList();\n                logger.debug(\"sendRequest: Local handling - Transferring files: {} to {}. RequestName: {}\",\n                        transferFile, receiveTransferFile, requestName);\n                transferFile(new ArrayList<>(transferFile), receiveTransferFile, null);\n            }\n\n            logger.info(\"Local can handle\"); // Existing log\n\n            boolean isOffer = requestQueue.offer(taskRequestToMap(taskRequest));\n            logger.debug(\"sendRequest: Offered to local requestQueue: {}. RequestName: {}\", isOffer, requestName);\n            if (!isOffer) {\n                logger.error(\"Queue is full!!\");\n            }\n            return;\n        }\n\n        if (!hasBroker) {\n            logger.error(\"sendRequest: Cannot handle locally and no upstream broker. RequestName: {}\", requestName);\n            TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n            failureResult.setState(false);\n            failureResult.setSuccess(false);\n            failureResult.setErrorMessage(\"Cannot handle locally and no upstream broker.\");\n            outputResponse(requestName, taskResultToMap(failureResult));\n            return;\n        }\n\n        logger.debug(\"sendRequest: Handling request via broker. RequestName: {}\", requestName);\n\n        AtomicReference<RegisteResponse> responseContainer = new AtomicReference<>();\n\n        String brokerHost = ((InetSocketAddress) network.getBrokerChannel().remoteAddress()).getHostName();\n        logger.debug(\"sendRequest: Upstream brokerHost: {}. RequestName: {}\", brokerHost, requestName);\n        logger.info(\"brokerHost -> {}\", brokerHost); // Existing log\n\n        if (MulticastController.getMode().equals(\"isBroker\")) {\n            logger.debug(\"sendRequest: Current node isBroker, adding self to brokerRoute. RequestName: {}\",\n                    requestName);\n            taskRequest.addBrokerToRoute(HiBAInitial.nodeName);\n        }\n\n        if (taskRequest.hasTransferFile()) {\n            String receiveTransferFile = taskRequest.getReceiveTargetPath();\n            java.util.List<String> transferFile = taskRequest.getTransferFileList();\n            logger.debug(\n                    \"sendRequest: Remote handling - Transferring files: {} to {} via brokerHost: {}. RequestName: {}\",\n                    transferFile, receiveTransferFile, brokerHost, requestName);\n            transferFile(new ArrayList<>(transferFile), receiveTransferFile, brokerHost);\n        }\n\n        Map<String, Object> requestInformation = taskRequestToMap(taskRequest);\n        logger.debug(\"sendRequest: Sending RegisteMessage to broker. RequestName: {}\", requestName);\n\n        network.sendShortConnectMessage(brokerHost,\n                new RegisteMessage(requestName, 86400, System.currentTimeMillis(), requestInformation),\n                new Initializer() {\n                    @Override\n                    public void initial(Channel channel) {\n                        logger.debug(\n                                \"sendRequest: RegisteMessage channel initialized to broker. Local: {}, Remote: {}. RequestName: {}\",\n                                channel.localAddress(), channel.remoteAddress(), requestName);\n                        channel.pipeline().addLast(new ChannelInboundHandlerAdapter() {\n                            @Override\n                            public void channelReadComplete(ChannelHandlerContext ctx) throws Exception {\n                                logger.debug(\n                                        \"sendRequest: RegisteMessage channelReadComplete, closing channel. RequestName: {}\",\n                                        requestName);\n                                ctx.channel().close();\n                                super.channelReadComplete(ctx);\n                            }\n\n                            @Override\n                            public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                                logger.error(\n                                        \"sendRequest: Exception in RegisteMessage channel handler. RequestName: {}\",\n                                        requestName, cause);\n                                ctx.close();\n                            }\n                        });\n\n                        channel.pipeline().addLast(new SimpleChannelInboundHandler<RegisteResponse>() {\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, RegisteResponse msg) {\n                                responseContainer.set(msg);\n                                logger.debug(\n                                        \"sendRequest: Received RegisteResponse: Success? {}, HandleBrokerHost: {}. RequestName: {}\",\n                                        msg.isSuccess(), msg.getHandleBrokerHost(), requestName);\n                                logger.info(\"Registe Result : {} broker IP: {}\", msg.isSuccess(),\n                                        ctx.channel().remoteAddress()); // Existing\n                            }\n                        });\n                    }\n                });\n\n        if (responseContainer.get() == null) {\n            logger.warn(\n                    \"sendRequest: RegisteResponse was not yet available immediately after sendShortConnectMessage call. RequestName: {}. This might indicate an asynchronous operation without proper waiting.\",\n                    requestName);\n            if (responseContainer.get() == null) {\n                logger.error(\"sendRequest: RegisteResponse is definitively null after a brief wait. RequestName: {}\",\n                        requestName);\n                TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n                failureResult.setState(false);\n                failureResult.setSuccess(false);\n                failureResult.setErrorMessage(\"No RegisteResponse received from broker (timeout or other issue).\");\n                outputResponse(requestName, taskResultToMap(failureResult));\n                return;\n            }\n        }\n\n        logger.info(\"----------------{}  {}\", responseContainer.get(),\n                responseContainer.get().getHandleBrokerHost()); // Existing\n        RegisteResponse response = responseContainer.get();\n        if (response.isSuccess()) {\n            logger.debug(\n                    \"sendRequest: RegisteResponse successful. HandleBrokerHost: {}, DirectBrokerHost: {}. Sending WaitingRequestMessage to direct broker via long connection. RequestName: {}\",\n                    response.getHandleBrokerHost(), brokerHost, requestName);\n            // 用於等待 RequestFinishMessage 的同步機制\n            AtomicReference<Map<String, Object>> requestFinishResult = new AtomicReference<>(null);\n            AtomicReference<String> errorMessage = new AtomicReference<>(null);\n            AtomicReference<Channel> longConnectionChannel = new AtomicReference<>(null);\n\n            network.sendConnectMessage(brokerHost, new WaitingRequestMessage(requestName),\n                    channel -> {\n                        // 保存 channel 引用供後續檢查\n                        longConnectionChannel.set(channel);\n\n                        logger.debug(\n                                \"sendRequest: WaitingRequestMessage channel (for RequestFinishMessage) PIPELINE SETUP START. Local: {}, Remote: {}. RequestName: {}\",\n                                channel.localAddress(), channel.remoteAddress(), requestName); // Add\n\n                        channel.pipeline().addLast(\"GenericDebugHandler_For_RequestFinishMessage_Channel\",\n                                new ChannelInboundHandlerAdapter() {\n                                    @Override\n                                    public void channelRegistered(ChannelHandlerContext ctx) throws Exception {\n                                        logger.debug(\"[{}] RFM_CHAN: Channel Registered: {}\", requestName,\n                                                ctx.channel());\n                                        super.channelRegistered(ctx);\n                                    }\n\n                                    @Override\n                                    public void channelUnregistered(ChannelHandlerContext ctx) throws Exception {\n                                        logger.debug(\"[{}] RFM_CHAN: Channel Unregistered: {}\", requestName,\n                                                ctx.channel());\n                                        super.channelUnregistered(ctx);\n                                    }\n\n                                    @Override\n                                    public void channelActive(ChannelHandlerContext ctx) throws Exception {\n                                        logger.debug(\"[{}] RFM_CHAN: Channel Active: {}\", requestName, ctx.channel());\n                                        super.channelActive(ctx);\n                                    }\n\n                                    @Override\n                                    public void channelInactive(ChannelHandlerContext ctx) throws Exception {\n                                        logger.error(\n                                                \"[{}] RFM_CHAN: Channel Inactive (DISCONNECTED!): {}. This may cause RequestFinishMessage to be lost!\",\n                                                requestName, ctx.channel());\n                                        errorMessage.set(\"Channel became inactive\");\n                                        super.channelInactive(ctx);\n                                    }\n\n                                    @Override\n                                    public void channelRead(ChannelHandlerContext ctx, Object msg) throws Exception {\n                                        logger.info(\n                                                \"[{}] RFM_CHAN: *** RECEIVED DATA *** Message type: {}, Message: {}\",\n                                                requestName, msg.getClass().getName(), msg.toString());\n                                        // Pass it on to the next handler\n                                        // (SimpleChannelInboundHandler<RequestFinishMessage>)\n                                        super.channelRead(ctx, msg);\n                                    }\n\n                                    @Override\n                                    public void channelReadComplete(ChannelHandlerContext ctx) throws Exception {\n                                        logger.debug(\"[{}] RFM_CHAN: Channel Read Complete: {}\", requestName,\n                                                ctx.channel());\n                                        super.channelReadComplete(ctx);\n                                    }\n\n                                    @Override\n                                    public void userEventTriggered(\n                                            ChannelHandlerContext ctx, Object evt)\n                                            throws Exception {\n                                        logger.debug(\"[{}] RFM_CHAN: User Event Triggered: {}, Event: {}\",\n                                                requestName,\n                                                ctx.channel(), evt);\n                                        super.userEventTriggered(ctx, evt);\n                                    }\n\n                                    @Override\n                                    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause)\n                                            throws Exception {\n                                        logger.error(\"[{}] RFM_CHAN: Exception Caught in GenericDebugHandler: {}\",\n                                                requestName, cause.getMessage(), cause);\n                                        errorMessage.set(\"Exception in channel: \"\n                                                + cause.getMessage());\n                                        super.exceptionCaught(ctx, cause); // Important to propagate\n                                    }\n                                });\n\n                        channel.pipeline().addLast(fileTransferHandler); // Still commented out\n\n                        channel.pipeline().addLast(\"RequestFinishMessageHandler\",\n                                new SimpleChannelInboundHandler<RequestFinishMessage>() {\n                                    @Override\n                                    public void channelActive(ChannelHandlerContext ctx2) throws Exception {\n                                        logger.debug(\"[{}] RFM_HANDLER: Channel Active for RequestFinishMessage\",\n                                                requestName);\n                                        super.channelActive(ctx2);\n                                    }\n\n                                    @Override\n                                    public void channelInactive(ChannelHandlerContext ctx2) throws Exception {\n                                        logger.debug(\"[{}] RFM_HANDLER: Channel Inactive for RequestFinishMessage\",\n                                                requestName);\n                                        super.channelInactive(ctx2);\n                                    }\n\n                                    @Override\n                                    @SuppressWarnings(\"unchecked\")\n                                    protected void channelRead0(ChannelHandlerContext ctx2,\n                                            RequestFinishMessage msg2) {\n                                        logger.info(\n                                                \"sendRequest: *** RECEIVED RequestFinishMessage *** RequestName: {}\",\n                                                requestName);\n                                        logger.debug(\"sendRequest: RequestFinishMessage details: {}\",\n                                                msg2.getRequestResult());\n                                        try {\n                                            Map<String, Object> resultMsg = (Map<String, Object>) msg2\n                                                    .getRequestResult()\n                                                    .get(\"result\");\n                                            Map<String, Object> taskDetails = (Map<String, Object>) msg2.getRequestResult()\n                                                    .get(\"allResult\");\n                                            resultMsg.put(\"taskDetails\", taskDetails);\n                                            resultMsg.put(\"state\", true);\n\n                                            // 設置結果，通知主線程\n                                            requestFinishResult.set(resultMsg);\n                                            logger.info(\n                                                    \"sendRequest: *** RequestFinishMessage processed successfully, main thread will be notified *** RequestName: {}\",\n                                                    requestName);\n                                        } catch (Exception e) {\n                                            logger.error(\n                                                    \"sendRequest: Error processing taskDetails from RequestFinishMessage. RequestName: {}\",\n                                                    requestName, e);\n                                            errorMessage.set(\n                                                    \"Error processing RequestFinishMessage: \"\n                                                            + e.getMessage());\n                                        }\n                                        logger.debug(\n                                                \"sendRequest: WaitingRequestMessage channelRead0 complete, closing channel. RequestName: {}\",\n                                                requestName);\n                                        ctx2.channel().close();\n                                    }\n\n                                    @Override\n                                    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause)\n                                            throws Exception {\n                                        logger.error(\n                                                \"sendRequest: Exception in WaitingRequestMessage (RequestFinishMessage) channel handler. RequestName: {}\",\n                                                requestName, cause);\n                                        errorMessage.set(\n                                                \"Exception while waiting for/processing RequestFinishMessage: \"\n                                                        + cause.getMessage());\n                                        ctx.close();\n                                    }\n                                });\n                        logger.debug(\n                                \"sendRequest: WaitingRequestMessage channel (for RequestFinishMessage) PIPELINE SETUP END. RequestName: {}\",\n                                requestName);\n                    }, false); // 使用長連線模式，不關閉連線 // 等待 RequestFinishMessage 的回應\n            logger.debug(\"sendRequest: Waiting for RequestFinishMessage response. RequestName: {}\", requestName);\n            long waitStartTime = System.currentTimeMillis();\n            long timeout = 60000; // 60 秒超時\n            int checkCount = 0;\n\n            while (requestFinishResult.get() == null && errorMessage.get() == null\n                    && (System.currentTimeMillis() - waitStartTime) < timeout) {\n\n                checkCount++;\n\n                // 檢查 channel 是否還 active\n                Channel currentChannel = longConnectionChannel.get();\n                if (currentChannel != null && !currentChannel.isActive()) {\n                    logger.error(\n                            \"sendRequest: Long connection channel became inactive while waiting for RequestFinishMessage! RequestName: {}, Channel: {}\",\n                            requestName, currentChannel);\n                    errorMessage.set(\"Long connection channel became inactive\");\n                    break;\n                }\n\n                // 每5秒輸出一次診斷信息\n                if (checkCount % 50 == 0) {\n                    long elapsed = System.currentTimeMillis() - waitStartTime;\n                    logger.info(\n                            \"sendRequest: Still waiting for RequestFinishMessage. RequestName: {}, Elapsed: {}ms, Channel Active: {}\",\n                            requestName, elapsed,\n                            (currentChannel != null ? currentChannel.isActive() : \"null\"));\n                }\n\n                try {\n                    Thread.sleep(100); // 每100毫秒檢查一次\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                    logger.error(\"sendRequest: Interrupted while waiting for RequestFinishMessage. RequestName: {}\",\n                            requestName, e);\n                    TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n                    failureResult.setState(false);\n                    failureResult.setSuccess(false);\n                    failureResult.setErrorMessage(\"Interrupted while waiting for RequestFinishMessage\");\n                    outputResponse(requestName, taskResultToMap(failureResult));\n                    return;\n                }\n            }\n\n            // 關閉長連線\n            Channel currentChannel = longConnectionChannel.get();\n            if (currentChannel != null && currentChannel.isActive()) {\n                logger.debug(\"sendRequest: Closing long connection channel. RequestName: {}\", requestName);\n                currentChannel.close();\n            }\n\n            // 處理結果\n            if (requestFinishResult.get() != null) {\n                logger.debug(\"sendRequest: RequestFinishMessage received successfully. RequestName: {}\",\n                        requestName);\n                outputResponse(requestName, requestFinishResult.get());\n            } else if (errorMessage.get() != null) {\n                logger.error(\n                        \"sendRequest: Error occurred while processing RequestFinishMessage. RequestName: {}. Error: {}\",\n                        requestName, errorMessage.get());\n                TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n                failureResult.setState(false);\n                failureResult.setSuccess(false);\n                failureResult.setErrorMessage(errorMessage.get());\n                outputResponse(requestName, taskResultToMap(failureResult));\n            } else {\n                logger.error(\"sendRequest: Timeout waiting for RequestFinishMessage. RequestName: {}\",\n                        requestName);\n                TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n                failureResult.setState(false);\n                failureResult.setSuccess(false);\n                failureResult.setErrorMessage(\"Timeout waiting for RequestFinishMessage after \"\n                        + (timeout / 1000) + \" seconds\");\n                outputResponse(requestName, taskResultToMap(failureResult));\n            }\n\n        } else {\n            logger.error(\"sendRequest: RegisteResponse was not successful. RequestName: {}. Info from broker: {}\",\n                    requestName, response.getHandleBrokerHost());\n            TaskResult failureResult = new TaskResult(requestName, serviceName, \"unknown\");\n            failureResult.setState(false);\n            failureResult.setSuccess(false);\n            failureResult.setErrorMessage(\n                    \"Registration with broker failed. Broker info: \" + response.getHandleBrokerHost());\n            outputResponse(requestName, taskResultToMap(failureResult));\n        }\n        logger.debug(\"sendRequest: Exit. RequestName: {}\", requestName);\n    }\n\n    public void outputResponse(String responseName, Map<String, Object> responseMsg) {\n        try {\n            Map<String, Object> upperBrokerResponse = new HashMap<>(responseMsg);\n\n            // 檢查 requestTimeStamp 是否存在，如果不存在則使用當前時間\n            Object requestTimeStampObj = upperBrokerResponse.get(\"requestTimeStamp\");\n            long startTime;\n            if (requestTimeStampObj instanceof Long) {\n                startTime = (Long) requestTimeStampObj;\n            } else {\n                // 如果沒有 requestTimeStamp（例如超時情況），使用當前時間減去一個合理的估計時間\n                Map<String, Object> localTime = getLocalTime();\n                startTime = (long) localTime.get(\"timeStamp\") - 30000; // 假設請求耗時 30 秒\n                logger.warn(\"outputResponse: requestTimeStamp not found, using estimated time. ResponseName: {}\",\n                        responseName);\n            }\n\n            Map<String, Object> localTime = getLocalTime();\n            long endTime = (long) localTime.get(\"timeStamp\");\n            double executionTime = (endTime - startTime) / 1000.000;\n\n            upperBrokerResponse.put(\"taskCompletionTime\", endTime);\n            upperBrokerResponse.put(\"taskCompletionTimeStamp\", localTime.get(\"timeStamp\"));\n            upperBrokerResponse.put(\"taskExecutionTime\", executionTime);\n\n            logger.debug(upperBrokerResponse.toString());\n\n            if (\"getFile\".equals(upperBrokerResponse.get(\"serviceName\"))) {\n                boolean verificationResult = verifyGetFileResponse(upperBrokerResponse);\n                logger.info(\"Overall getFile verification result: {}\", verificationResult ? \"PASSED\" : \"FAILED\");\n            }\n\n            String responseFile = \"./response\" + File.separator\n                    + responseName + \"_\" + localTime.get(\"date\") + \".json\";\n\n            JsonFileTool.WriteFile(new JSONObject(upperBrokerResponse), new File(responseFile));\n\n            logger.info(\"-------- END -------\");\n            logger.info(\"Request name   : {}\", upperBrokerResponse.get(\"serviceName\"));\n            logger.info(\"Execution time : {} sec.\", executionTime);\n            logger.info(\"Response file  : {}\", responseFile);\n\n            logger.info(\"\");\n            logger.info(\"- Result : \");\n            for (String key : upperBrokerResponse.keySet()) {\n                logger.info(\"  > {}: {}\", key, upperBrokerResponse.get(key));\n            }\n            logger.info(\"--------------------\");\n        } catch (IOException e) {\n            logger.error(\"An error occurred parsing the response.\");\n            e.printStackTrace();\n        }\n    }\n\n    public static void traverseDirectory(File directory, ArrayList<String> list) {\n        if (directory.isDirectory()) {\n            File[] files = directory.listFiles();\n            for (File file : files) {\n                if (file.isFile()) {\n                    list.add(file.getPath());\n                } else {\n                    traverseDirectory(file, list);\n                }\n            }\n        }\n    }\n\n    /**\n     * Verify getFile response and all transferred files\n     *\n     * @param upperBrokerResponse The complete response from broker\n     * @return true if all files pass verification, false otherwise\n     */\n    private boolean verifyGetFileResponse(Map<String, Object> upperBrokerResponse) {\n        try {\n            // 使用upperBrokerResponse中的transfers資料進行檔案驗證\n            @SuppressWarnings(\"unchecked\")\n            List<Map<String, Object>> transfers = (List<Map<String, Object>>) upperBrokerResponse.get(\"transfers\");\n\n            if (transfers == null || transfers.isEmpty()) {\n                logger.warn(\"No transfers found in response for service 'getFile'.\");\n                return false;\n            }\n\n            boolean allVerificationsPassed = true;\n\n            for (Map<String, Object> transfer : transfers) {\n                String fileName = (String) transfer.get(\"fileName\");\n                String targetPath = (String) transfer.get(\"targetPath\");\n\n                if (targetPath != null && fileName != null) {\n                    String fullFilePath = targetPath + File.separator + fileName;\n                    File receivedFile = new File(fullFilePath);\n\n                    logger.info(\"Verifying received file: {}\", fileName);\n                    logger.info(\"File path: {}\", fullFilePath);\n\n                    // 執行單個檔案驗證\n                    boolean singleFileResult = performSingleFileVerification(transfer, receivedFile);\n                    if (!singleFileResult) {\n                        allVerificationsPassed = false;\n                    }\n                } else {\n                    logger.error(\"Missing fileName or targetPath in transfer data\");\n                    allVerificationsPassed = false;\n                }\n            }\n\n            return allVerificationsPassed;\n\n        } catch (Exception e) {\n            logger.error(\"Error during getFile verification: {}\", e.getMessage(), e);\n            return false;\n        }\n    }\n\n    /**\n     * Perform file verification for a single transferred file\n     *\n     * @param transfer     Transfer information from upperBrokerResponse\n     * @param receivedFile The received file\n     * @return true if verification passes, false otherwise\n     */\n    private boolean performSingleFileVerification(Map<String, Object> transfer, File receivedFile) {\n        try {\n            String fileName = (String) transfer.get(\"fileName\");\n            String blockchainTxHash = (String) transfer.get(\"blockchainTxHash\");\n            String expectedFileHash = (String) transfer.get(\"fileHash\");\n            String fileId = (String) transfer.get(\"fileId\");\n            String blockchainStatus = (String) transfer.get(\"blockchainStatus\");\n\n            logger.info(\"Starting file verification for: {}\", fileName);\n            logger.info(\"File ID: {}\", fileId);\n            logger.info(\"Blockchain Status: {}\", blockchainStatus);\n            logger.info(\"Expected Hash: {}\", expectedFileHash);\n            logger.info(\"Blockchain TxHash: {}\", blockchainTxHash);\n\n            if (!receivedFile.exists()) {\n                logger.error(\"❌ File verification FAILED: File does not exist at {}\", receivedFile.getAbsolutePath());\n                return false;\n            }\n\n            // 計算接收檔案的實際hash\n            String actualFileHash = HashUtil.calculateFileHash(receivedFile);\n\n            if (expectedFileHash.equals(actualFileHash)) {\n                logger.info(\"✅ File hash verification PASSED for: {}\", fileName);\n\n                // 如果有區塊鏈交易hash，進行進階驗證\n                if (blockchainTxHash != null && !\"SUCCESS\".equals(blockchainStatus)) {\n                    logger.warn(\"⚠\uFE0F Blockchain status is not SUCCESS: {}\", blockchainStatus);\n                } else if (blockchainTxHash != null) {\n                    // 從區塊鏈驗證檔案metadata\n                    FileMetadata blockchainMetadata = fileProtectionService.recoverFromBlockchain(blockchainTxHash);\n                    if (blockchainMetadata != null && blockchainMetadata.getFileHash().equals(actualFileHash)) {\n                        logger.info(\"✅ Blockchain verification PASSED for: {}\", fileName);\n                    } else {\n                        logger.warn(\"❌ Blockchain verification FAILED for: {}\", fileName);\n                    }\n                }\n                return true;\n            } else {\n                logger.error(\"❌ File hash verification FAILED for: {}\", fileName);\n                logger.error(\"Expected: {}\", expectedFileHash);\n                logger.error(\"Actual: {}\", actualFileHash);\n                return false;\n            }\n\n        } catch (Exception e) {\n            logger.error(\"File verification error: {}\", e.getMessage(), e);\n            return false;\n        }\n    }\n\n\n    public void transferFile(ArrayList<String> transferFile, String receiveTransferFile, String brokerHost) {\n        for (String path : transferFile) {\n            ArrayList<String> transferFileList = new ArrayList<>();\n            traverseDirectory(new File(path), transferFileList);\n            for (String file : transferFileList) {\n                logger.info(\"file: {}\", file);\n                File file1 = new File(file);\n                String fileRelativePath = file1.getParent().replaceAll(\"\\\\.\", \"\");\n                if (brokerHost != null) {\n                    FileTransferClient.doTransfer(file, receiveTransferFile + fileRelativePath, brokerHost, null,\n                            HiBAInitial.DATA_PORT);\n                } else {\n                    try {\n                        Files.copy(file1.toPath(), new File(\n                                        receiveTransferFile + fileRelativePath + File.separator + file1.getName()).toPath(),\n                                StandardCopyOption.REPLACE_EXISTING);\n                    } catch (IOException e) {\n                        e.printStackTrace();\n                        logger.error(\"An error occurred while copying: {}\", e.getMessage());\n                    }\n                }\n            }\n        }\n    }\n\n    private synchronized void nodeDisconnectWhenCompute(String nodeName) {\n        if (taskDistributeList.containsKey(nodeName)) {\n            Map<String, Object> task = taskDistributeList.get(nodeName);\n            distributor.handleTaskFail(nodeName, resourceList.get(nodeName), task);\n            logger.info(\"加入失敗清單: {}\", task);\n            failedTaskList.add(task); // 測試用, 重新分派離線節點的任務\n            reassignTask = true;\n            taskDistributeList.remove(nodeName);\n        }\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private Map<String, Object> getAllResource() {\n\n        Map<String, Object> local = new HashMap<>(localResource);\n        Map<String, Object> allResource = new HashMap<>(local);\n\n        Map<String, Map<String, Object>> resourceListClone = new HashMap<>(resourceList);\n\n        for (String name : resourceListClone.keySet()) {\n            Map<String, Object> resource = new HashMap<>(resourceListClone.get(name));\n            for (String resourceKey : resource.keySet()) {\n                Object value = resource.get(resourceKey);\n                if (value instanceof ArrayList<?>) {\n                    ArrayList<String> temp = new ArrayList<>();\n                    ArrayList<String> fileNameList = (ArrayList<String>) value;\n                    if (allResource.containsKey(resourceKey)) {\n                        ArrayList<String> sumList = (ArrayList<String>) allResource.get(resourceKey);\n                        temp.addAll(fileNameList);\n                        temp.addAll(sumList);\n                        allResource.replace(resourceKey, temp);\n                    } else {\n                        allResource.put(resourceKey, fileNameList);\n                    }\n                } else if (value instanceof Integer) {\n                    int resourceValue = (int) resource.get(resourceKey);\n                    if (allResource.containsKey(resourceKey)) {\n                        int allResourceValue = (int) allResource.get(resourceKey);\n                        allResource.put(resourceKey, allResourceValue + resourceValue);\n                    } else {\n                        allResource.put(resourceKey, resourceValue);\n                    }\n                }\n            }\n        }\n\n        // // HiBA v3實驗用, 向Broker傳遞當前設備硬體資訊\n        // if (HiBAInitial.updateDeviceInfo &\n        // !MulticastController.getMode().equals(\"isBroker\")) {\n        // // ArrayList<ArrayList<Object>> deviceInfo = new ArrayList<>();\n        // // ArrayList<Object> getRateInfo = new ArrayList<>();\n        // // Map<String, Object> getRate = CPUUsageRate.getCPURate();\n        // // getRate.put(\"nodeName\", HiBAInitial.nodeName);\n        // // getRateInfo.add(getRate);\n        // // deviceInfo.add(getRateInfo);\n        // // allResource.put(\"deviceInfo\", deviceInfo);\n        // ArrayList<Object> deviceInfo = new ArrayList<>();\n        // Map<String, Object> getRate = CPUUsageRate.getCPURate();\n        // getRate.put(\"nodeName\", HiBAInitial.nodeName);\n        // deviceInfo.add(getRate.toString());\n        // allResource.put(\"deviceInfo\", deviceInfo);\n        // }\n\n        // HiBANetwork get資料用\n        nodeResource = allResource;\n        return allResource;\n    }\n\n    private HiBAService getService(String name) {\n        HiBAService service = serviceList.get(name);\n        if (service != null) {\n            service = serviceList.get(name).getNewInstance();\n        }\n        return service;\n    }\n\n    private Map<String, Object> getLocalTime() {\n        Map<String, Object> timeInfo = new HashMap<>();\n        long timeStamp = System.currentTimeMillis();\n        SimpleDateFormat dataFormat = new SimpleDateFormat(\"yyyy-MM-dd_HH-mm-ss_S\");\n        String date = dataFormat.format(new Date(Long.parseLong(String.valueOf(timeStamp))));\n        timeInfo.put(\"timeStamp\", timeStamp);\n        timeInfo.put(\"date\", date);\n        return timeInfo;\n    }\n\n    private Map<String, Object> createErrorResult(String errorMessage) {\n        Map<String, Object> errorResult = new HashMap<>();\n        errorResult.put(\"success\", false);\n        errorResult.put(\"error\", errorMessage);\n        return errorResult;\n    }\n\n}
