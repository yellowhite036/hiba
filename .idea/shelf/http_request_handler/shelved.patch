tQueue is full for requestName: {}. Sending failure RegisteResponse.\",\n                                                requestName);\n                                        ctx.channel().writeAndFlush(\n                                                new RegisteResponse(msg.getRequestName(), false,\n                                                        \"Broker queue is full\"));\n                                        return;\n                                    }\n                                    logger.debug(\n                                            \"initializeServerHandler.RegisteMessageHandler: Sending RegisteResponse (success=true) to {}. RequestName: {}\",\n                                            ctx.channel().remoteAddress(), requestName);\n                                    ctx.channel().writeAndFlush(\n                                            new RegisteResponse(msg.getRequestName(), true,\n                                                    network.getLocal().getValue()));\n                                } else {\n                                    logger.info(\"Local can't take request : {} , service : {}\", requestName,\n                                            serviceName);\n                                    logger.debug(\n                                            \"initializeServerHandler.RegisteMessageHandler: Local cannot take request. RequestName: {}\",\n                                            requestName);\n                                    if (!hasBroker) {\n                                        logger.warn(\n                                                \"initializeServerHandler.RegisteMessageHandler: No upstream broker and local cannot handle. Sending RegisteResponse (success=false). RequestName: {}\",\n                                                requestName);\n                                        ctx.channel().writeAndFlush(new RegisteResponse(msg.getRequestName(), false,\n                       