ndler: Sending WaitingRequestMessage to handleBrokerHost: {}. RequestName: {}\",\n                                                    response.getHandleBrokerHost(), requestName);\n\n                                            network.sendShortConnectMessage(response.getHandleBrokerHost(),\n                                                    new WaitingRequestMessage(requestName),\n                                                    channel2 -> {\n                                                        logger.debug(\n                                                                \"initializeServerHandler.RegisteMessageHandler.sendShortConnectMessage (for RequestFinishMessage): Channel initialized to {}. Local: {}, Remote: {}. RequestName: {}\",\n                                                                response.getHandleBrokerHost(), channel2.localAddress(),\n                                                                channel2.remoteAddress(),\n                                                                requestName);\n                                                        channel2.pipeline().addLast(\n                                                                new SimpleChannelInboundHandler<RequestFinishMessage>() {\n                                                                    @Override\n                                                                    protected void channelRead0(\n                                                                            ChannelHandlerContext ctx2,\n                                                                            RequestFinishMessage msg2) {\n                                                                        logger.debug(\n                                                                                \"initializeServerHandler.RegisteMessageHandler.sendShortConnectMessage (for RequestFinishMessage): Received RequestFinishMessage. RequestName: {}\",\n                                    