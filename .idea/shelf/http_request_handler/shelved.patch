ogger.debug(\n                                                                                    \"initializeServerHandler.RegisteMessageHandler.sendShortConnectMessage (for RegisteResponse): Closing channel. RequestName: {}\",\n                                                                                    requestName);\n                                                                            ctx2.channel().close();\n                                                                        }\n\n                                                                        @Override\n                                                                        public void exceptionCaught(\n                                                                                ChannelHandlerContext ctx2,\n                                                                                Throwable cause) throws Exception {\n                                                                            logger.error(\n                                                                                    \"initializeServerHandler.RegisteMessageHandler.sendShortConnectMessage (for RegisteResponse): Exception caught for channel {}: {}. RequestName: {}\",\n                                                                                    ctx2.channel(), cause.getMessage(),\n                                                                                    requestName,\n                                                                                    cause);\n                                                                            temp.set(new RegisteResponse(requestName,\n                                                                                    false,\n                                                                                    \"Exception during upstream registration: \"\n                                                                                            + cause.ge