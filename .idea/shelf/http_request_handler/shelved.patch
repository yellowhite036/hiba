er;\nimport org.slf4j.LoggerFactory;\n\npublic class App {\n\n    private static final Logger logger = LoggerFactory.getLogger(App.class);\n\n    private final SdnNetwork network;\n    private Map<String, Object> localResource = new HashMap<>();\n    private final Map<String, HiBAService> serviceList = new HashMap<>(); // serviceName : HiBAservice\n    private final BlockingQueue<Map<String, Object>> requestQueue = new LinkedBlockingQueue<>(10);\n    private final Map<String, Map<String, Object>> resourceList = new ConcurrentHashMap<>(); // nodeName : resourceMap\n    private final Map<String, Map<String, Object>> taskDistributeList = new ConcurrentHashMap<>(); // nodeName : taskMap\n    private final Map<String, Map<String, Object>> taskResultList = new ConcurrentHashMap<>(); // nodeName : resultMap\n    private final Map<String, Channel> requestResultWaiterList = new ConcurrentHashMap<>(); // requestName :\n    // registeNodeChannel\n    private final Map<String, Channel> upperBrokerRequestResultWaiterList = new ConcurrentHashMap<>(); // requestName :\n    // registeUpperBrokerChannel\n    private final Map<String, Map<String, Object>> originalRequestInformationMap = new ConcurrentHashMap<>(); // requestName : originalRequestInformation\n    private final ArrayList<Map<String, Object>> failedTaskList = new ArrayList<>();\n    private Boolean reassignTask = false;\n\n    private final FileTransferHandler fileTransferHandler = new FileTransferHandler();\n    private final FileProtectionService fileProtectionService;\n\n    private ExecutorService taskExecutor = Executors.newCachedThreadPool();\n    private Distributor distributor = null;\n    private Thread distributeThread = null;\n    public static Map<String, Object> method = new HashMap<>();\n    public static Map<String, Object> nodeResource = new HashMap<>(); // 暫時用, 給HiBANetwork 更新CPU使用率用\n\n    // 新舊資料結構轉換的輔助方法\n\n    /**\n     * 將 Map 格式的請求轉換為 TaskRequest 物件\n     */\n    private TaskRequest mapToTaskRequest(Map<String, Object> requestMap) {\n        return TaskRequest.fromMap(requestMap);\n    }\n\n    /**\n     * 將 TaskRequest 物件轉換為 Map 格式（向後兼容）\n     */\n    private Map<String, Object> taskRequestToMap(TaskRequest request) {\n        return request.toMap();\n    }\n\n    /**\n     * 將 Map 格式的任務分配轉換為 TaskAssignment 物件\n     */\n    private TaskAssignment mapToTaskAssignment(Map<String, Object> taskMap) {\n        return TaskAssignment.fromMap(taskMap);\n    }\n\n    /**\n     * 將 TaskAssignment 物件轉換為 Map 格式（向後兼容）\n     */\n    private Map<String, Object> taskAssignmentToMap(TaskAssignment assignment) {\n        return assignment.toMap();\n    }\n\n    /**\n     * 將 Map 格式的結果轉換為 TaskResult 物件\n     * TODO: 在下一階段重構中使用，當我們重構 taskResultList 和相關邏輯時\n     */\n    @SuppressWarnings(\"unused\")\n    private TaskResult mapToTaskResult(Map<String, Object> resultMap) {\n        return TaskResult.fromMap(resultMap);\n    }\n\n    /**\n     * 將 TaskResult 物件轉換為 Map 格式（向後兼容）\n     */\n    private Map<String, Object> taskResultToMap(TaskResult result) {\n        return result.toMap();\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    public App(SdnNetwork network) throws Exception {\n\n        AtomicInteger distributeNodes = new AtomicInteger(0);\n\n        distributeThread = initializeDistributeThread(distributeNodes);\n        distributeThread.start();\n        this.network = network;\n\n        this.network.clientInitialHandler(initializeClientHandler());\n\n        this.network.serverInitialHandler(initializeServerHandler());\n\n        this.fileProtectionService = BlockchainManager.getFileProtectionService();\n\n        network.start();\n    }\n\n    private Thread initializeDistributeThread(AtomicInteger distributeNodes) {\n        logger.debug(\"initializeDistributeThread: Entry. distributeNodes initial value: {}\", distributeNodes.get());\n        return new Thread(() -> {\n            logger.debug(\"initializeDistributeThread: Distribute thread started.\");\n            while (true) {\n                try {\n                    logger.debug(\"initializeDistributeThread: Waiting to take request from queue...\");\n                    Map<String, Object> requestMap = requestQueue.take();\n                    logger.debug(\"initializeDistributeThread: Took request from queue: {}\", requestMap);\n\n                    // 轉換為 TaskRequest 物件，獲得類型安全\n                    TaskRequest request = mapToTaskRequest(requestMap);\n                    String serviceName = request.getServiceName();\n                    String requestName = request.getRequestName();\n                    logger.debug(\"initializeDistributeThread: Processing requestName: {}, serviceName: {}\", requestName,\n                            serviceName);\n                    if (network.getClients().isEmpty()) { // getClients() => 獲得分派節點的數量\n                        logger.debug(\"initializeDistributeThread: No clients connected. RequestName: {}\", requestName);\n\n                        // 使用與 TaskResultHandler 相同的邏輯查找 channel\n                        Channel waitingChannel = requestResultWaiterList.get(requestName);\n                        String actualKey = requestName;\n\n                        if (waitingChannel == null) {\n                            for (String key : requestResultWaiterList.keySet()) {\n                                if (key.startsWith(requestName + \"_\")) {\n                                    waitingChannel = requestResultWaiterList.get(key);\n                                    actualKey = key;\n                                    logger.debug(\n                                            \"initializeDistributeThread: Found waiting channel using fallback key: {}\",\n                                            key);\n                                    break;\n                                }\n                            }\n                        }\n\n                        if (waitingChannel != null) {\n                            logger.debug(\n                                    \"initializeDistributeThread: Sending empty RequestFinishMessage to waiter for requestName: {}\",\n                                    requestName);\n                            waitingChannel.writeAndFlush(new RequestFinishMessage(new HashMap<>()));\n                            requestResultWaiterList.remove(actualKey);\n                            logger.debug(\"initializeDistributeThread: Removed waiter for requestKey: {}\",\n                                    actualKey);\n                        } else {\n                            logger.warn(\n                                    \"initializeDistributeThread: No waiting channel found for requestName: {}. Available keys: {}\",\n                                    requestName, requestResultWaiterList.keySet());\n                        }\n                        continue;\n                    }\n\n                    logger.info(\"start request : {}\", requestName);\n                    logger.info(\"request info : {}\", request);\n                    logger.debug(\"initializeDistributeThread: Looking up service: {}. RequestName: {}\", serviceName,\n                            requestName);\n                    HiBAService service = getService(serviceName);\n                    if (service == null) {\n                        logger.error(\"initializeDistributeThread: Service {} not found for requestName: {}\",\n                                serviceName, requestName);\n                        // Potentially send a failed response back if a waiter exists\n                        if (requestResultWaiterList.containsKey(requestName)) {\n                            Map<String, Object> failedResult = new HashMap<>();\n                            failedResult.put(\"error\", \"Service not found: \" + serviceName);\n                            failedResult.put(\"success\", false);\n                            requestResultWaiterList.get(requestName)\n                                    .writeAndFlush(new RequestFinishMessage(failedResult));\n                            requestResultWaiterList.remove(requestName);\n                        }\n                        continue;\n                    }\n\n                    AtomicInteger requestDistributeTier = new AtomicInteger(0);\n\n                    if (request.hasBrokerRoute()) {\n                        requestDistributeTier.set(request.getTier() + 1);\n                    }\n                    logger.info(\"get tier : {}\", requestDistributeTier.get());\n                    logger.debug(\"initializeDistributeThread: Initializing distributor. RequestName: {}\", requestName);\n                    distributor = service.getDistributor();\n                    distributor.setBrokerTier(requestDistributeTier.get());\n                    // 使用新的類型安全方法設定工作資訊\n                    distributor.setTaskRequest(request);\n                    distributor.setRequestID(requestName);\n                    distributor.initial();\n                    logger.debug(\"initializeDistributeThread: Distributor initialized. RequestName: {}\", requestName);\n\n                    do {\n                        logger.info(\"start distribute\");\n                        logger.debug(\n                                \"initializeDistributeThread: Starting distribution loop. RequestName: {}, HasMoreRound: {}, ReassignTask: {}\",\n                                requestName, distributor.hasMoreRound(), reassignTask);\n                        if (!failedTaskList.isEmpty()) {\n                            logger.info(\"重新分派執行失敗任務: \"); // Reassign failed tasks.\n                            logger.info(\"Task details:\");\n                            logger.info(\">> {}\", failedTaskList.getFirst());\n                            logger.debug(\"initializeDistributeThread: Reassigning failed task: {}. RequestName: {}\",\n                                    failedTaskList.getFirst(), requestName);\n                            distributor.setWorkInformation(failedTaskList.getFirst());\n                            // distributor.initial();\n                            failedTaskList.removeFirst();\n                        }\n                        if (failedTaskList.isEmpty()) {\n                            reassignTask = false;\n                        }\n                        boolean distributeFinish = false; // If the task only needs to be distributed once, return\n                        // True.\n                        distributeNodes.set(0);\n                        distributor.setClientSize(network.getClients().size());\n                        Iterator<Channel> nodesNameIterator = network.getClients().keySet().iterator();\n                        logger.debug(\n                                \"initializeDistributeThread: Iterating through client channels for distribution. Client count: {}. RequestName: {}\",\n                                network.getClients().size(), requestName);\n                        while (nodesNameIterator.hasNext() && !distributeFinish) { // 應該是broker分派任務的部份, 依序建channel\n                            Channel clientChannel = nodesNameIterator.next();\n                            try {\n                                String nodeName = network.getClients().get(clientChannel).getKey();\n                                Map<String, Object> nodeResource = resourceList.get(nodeName); // 使用新的類型安全方法進行任務分配\n                                logger.debug(\n                                        \"initializeDistributeThread: Mapping task for nodeName: {}. RequestName: {}\",\n                                        nodeName, requestName);\n                                TaskAssignment nodeTask = distributor.mappingTask(nodeName, nodeResource,\n                                        clientChannel, getAllResource());\n\n                                if (nodeTask != null) {\n                                    // 設定基本資訊\n                                    nodeTask.setRequestName(requestName);\n                                    nodeTask.setServiceName(serviceName);\n                                    nodeTask.setTier(requestDistributeTier.get());\n\n                                    logger.info(\"{} : distributed {}\", nodeName, nodeTask); // 檢查是否分配完成\n                                    logger.debug(\n                                            \"initializeDistributeThread: Task mapped for nodeName: {}. Task: {}. RequestName: {}\",\n                                            nodeName, nodeTask, requestName);\n                                    if (nodeTask.isDistributeFinish()) {\n                                        distributeFinish = true;\n                                        logger.debug(\n                                                \"initializeDistributeThread: Distribution finished for this round. RequestName: {}\",\n                                                requestName);\n                                    } // 轉換回 Map 以兼容現有系統\n                                    Map<String, Object> taskMap = taskAssignmentToMap(nodeTask);\n                                    if (nodeTask.isDistributeFinish()) {\n                                        taskMap.remove(\"distributeFinish\"); // 移除內部標記\n                                    }\n\n                                    taskDistributeList.put(nodeName, taskMap);\n                                    distributeNodes.addAndGet(1);\n                                    logger.debug(\n                                            \"initializeDistributeThread: Sending TaskStartMessage to nodeName: {}. TaskMap: {}. RequestName: {}\",\n                                            nodeName, taskMap, requestName);\n                                    clientChannel.writeAndFlush(new TaskStartMessage(requestName, taskMap));\n                                } else {\n                                    logger.debug(\n                                            \"initializeDistributeThread: No task mapped for nodeName: {}. RequestName: {}\",\n                                            nodeName, requestName);\n                                }\n                            } catch (Exception e) {\n                                logger.error(\"Distribute exception: {}\", e.getMessage());\n                                logger.error(\n                                        \"initializeDistributeThread: Exception during task distribution to node. RequestName: {}\",\n                                        requestName, e);\n                            }\n                        }\n                        if (!distributeFinish) {\n                            logger.debug(\"initializeDistributeThread: Mapping local task. RequestName: {}\",\n                                    requestName);\n                            TaskAssignment localTask = distributor.mappingLocalTask(localResource,\n                                    getAllResource());\n                            logger.info(\"end distribute\");\n                            if (localTask != null) { // 分派給Broker自己\n                                // 設定基本資訊\n                                localTask.setRequestName(requestName);\n                                localTask.setServiceName(serviceName);\n                                localTask.setNodeName(\"localhost\");\n                                localTask.setTier(requestDistributeTier.get());\n                                logger.debug(\"initializeDistributeThread: Local task mapped: {}. RequestName: {}\",\n                                        localTask, requestName);\n\n                                Executor executor = service.getExecutor();\n\n                                // 轉換回 Map 以兼容現有的 Executor 介面\n                                Map<String, Object> localTaskCompatMap = taskAssignmentToMap(localTask);\n\n                                executor.setTier(requestDistributeTier.get());\n                                executor.setTaskInformation(localTaskCompatMap);\n\n                                logger.info(\"local : distributed {}\", localTask);\n                                taskDistributeList.put(HiBAInitial.nodeName, localTaskCompatMap);\n                                logger.debug(\n                                        \"initializeDistributeThread: Submitting local task for execution. RequestName: {}\",\n                                        requestName);\n                                taskExecutor.submit(() -> {\n                                    logger.debug(\n                                            \"initializeDistributeThread: Local task execution started. RequestName: {}\",\n                                            requestName);\n                                    Map<String, Object> localResult = executor\n                                            .brokerExecute(localTaskCompatMap);\n                                    taskResultList.put(HiBAInitial.nodeName, localResult);\n                                    logger.info(\"Local : end task\");\n                                    logger.debug(\n                                            \"initializeDistributeThread: Local task execution finished. Result: {}. RequestName: {}\",\n                                            localResult, requestName);\n                                });\n                            } else {\n                                logger.debug(\"initializeDistributeThread: No local task mapped. RequestName: {}\",\n                                        requestName);\n                            }\n                        }\n                        if (taskDistributeList.isEmpty()) {\n                            // task fail\n                            logger.warn(\n                                    \"initializeDistributeThread: Task distribution list is empty after mapping. RequestName: {}\",\n                                    requestName);\n                        } else {\n                            logger.info(\"Task distributed to {} nodes\", distributeNodes.get());\n                            logger.debug(\"initializeDistributeThread: Task distributed to {} nodes. RequestName: {}\",\n                                    distributeNodes.get(), requestName);\n                        }\n\n                        boolean printCtrl = false;\n                        logger.debug(\n                                \"initializeDistributeThread: Waiting for task results. Distributed: {}, Results: {}. RequestName: {}\",\n                                taskDistributeList.size(), taskResultList.size(), requestName);\n                        while (taskDistributeList.size() > taskResultList.size()) {\n                            ArrayList<String> taskDistributeNodeNames = new ArrayList<>(taskDistributeList.keySet());\n                            ArrayList<String> nowAliveNodeNames = network.getClients().values().stream().map(\n                                    Entry::getKey).collect(Collectors.toCollection(ArrayList::new));\n                            nowAliveNodeNames.add(HiBAInitial.nodeName);\n\n                            taskDistributeNodeNames.removeAll(nowAliveNodeNames);\n\n                            if (!taskDistributeNodeNames.isEmpty()) {\n                                logger.warn(\n                                        \"initializeDistributeThread: Nodes disconnected during computation: {}. RequestName: {}\",\n                                        taskDistributeNodeNames, requestName);\n                                for (String name : taskDistributeNodeNames) {\n                                    nodeDisconnectWhenCompute(name);\n                                }\n                            }\n\n                            if (!printCtrl) {\n                                logger.info(\"waiting..\");\n                                printCtrl = true;\n                            }\n                            Thread.sleep(1000);\n                        }\n                        logger.info(\"------------- Merge node execution results -------------\");\n                        logger.debug(\n                                \"initializeDistributeThread: All task results received. Merging... RequestName: {}\",\n                                requestName);\n                        taskResultList.forEach((name, result) -> {\n                            logger.info(\"{} : result {}\", name, result);\n                            logger.info(\"-------------\");\n                        });\n\n                        distributor.merge(taskResultList);\n                        logger.debug(\"initializeDistributeThread: Results merged. Clearing task lists. RequestName: {}\",\n                                requestName);\n                        taskDistributeList.clear();\n                        taskResultList.clear();\n                    } while (distributor.hasMoreRound() || reassignTask);\n                    logger.debug(\"initializeDistributeThread: Distribution loop finished. RequestName: {}\",\n                            requestName);\n\n                    // 使用重構後的任務轉發處理器\n                    logger.debug(\"initializeDistributeThread: Handling task forwarding. RequestName: {}\", requestName);\n                    Map<String, Object> result = org.gslab.task.TaskForwardingHandler.handleTaskForwarding(\n                            distributor,\n                            requestDistributeTier,\n                            requestName,\n                            requestResultWaiterList,\n                            upperBrokerRequestResultWaiterList);// 使用重構後的任務結果處理器\n                    logger.debug(\"initializeDistributeThread: Task forwarding handled. Result: {}. RequestName: {}\",\n                            result, requestName);\n                    logger.debug(\"initializeDistributeThread: Handling task result. RequestName: {}\", requestName);\n                    org.gslab.task.TaskResultHandler.TaskHandleResult handleResult = org.gslab.task.TaskResultHandler\n                            .handleTaskResult(\n                                    result,\n                                    distributor,\n                                    requestName,\n                                    requestDistributeTier.get(),\n                                    requestResultWaiterList,\n                                    upperBrokerRequestResultWaiterList,\n                                    network);\n                    logger.debug(\"initializeDistributeThread: Task result handled. HandleResult: {}. RequestName: {}\",\n                            handleResult, requestName);\n\n                    // 根據處理結果決定是否繼續\n                    if (handleResult == org.gslab.task.TaskResultHandler.TaskHandleResult.CONTINUE) {\n                        logger.debug(\n                                \"initializeDistributeThread: Continuing to next request processing cycle. RequestName: {}\",\n                                requestName);\n                        continue;\n                    }\n\n                    outputResponse(requestName, result);\n\n                    // local request return\n                    logger.info(\"Local Request Finish : {}\", requestName);\n                    logger.debug(\"initializeDistributeThread: Local request finished. RequestName: {}\", requestName);\n                } catch (InterruptedException e) {\n                    logger.error(\"Broker Distribute Shutdown\");\n                    logger.error(\"initializeDistributeThread: Interrupted. Shutting down distribute thread.\", e);\n                    Thread.currentThread().interrupt();\n                    break;\n                } catch (Exception e) {\n                    logger.error(\"initializeDistributeThread: Uncaught exception in distribute thread loop.\", e);\n                    e.printStackTrace();\n                }\n            }\n            logger.debug(\"initializeDistributeThread: Distribute thread exiting.\");\n        });\n    }\n\n    private Initializer initializeServerHandler() {\n        logger.debug(\"initializeServerHandler: Entry.\");\n        return new SdnNetwork.Initializer() {\n            @Override\n            public void initial(Channel channel) {\n                logger.debug(\n                        \"initializeServerHandler.initial: Initializing server channel pipeline. Channel ID: {}, LocalAddress: {}, RemoteAddress: {}\",\n                        channel.id(), channel.localAddress(), channel.remoteAddress());\n\n                channel.pipeline().addLast(\"ServerLifecycleHandler\", new ChannelInboundHandlerAdapter() {\n                    @Override\n                    public void channelRegistered(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\"initializeServerHandler.ServerLifecycleHandler: Channel registered: {}\",\n                                ctx.channel());\n                        super.channelRegistered(ctx);\n                    }\n\n                    @Override\n                    public void channelUnregistered(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\"initializeServerHandler.ServerLifecycleHandler: Channel unregistered: {}\",\n                                ctx.channel());\n                        super.channelUnregistered(ctx);\n                    }\n\n                    @Override\n                    public void channelActive(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\"initializeServerHandler.ServerLifecycleHandler: Channel active: {}\",\n                                ctx.channel());\n                        super.channelActive(ctx);\n                    }\n\n                    @Override\n                    public void channelInactive(ChannelHandlerContext ctx) throws Exception {\n                        logger.debug(\"initializeServerHandler.ServerLifecycleHandler: Channel inactive: {}\",\n                                ctx.channel());\n                        if (network.getClients().containsKey(ctx.channel())) {\n                            String nodeName = network.getClients().get(ctx.channel()).getKey();\n                            logger.warn(\n                                    \"initializeServerHandler.ServerLifecycleHandler: Client node disconnected: {}. Channel: {}\",\n                                    nodeName, ctx.channel());\n                            nodeDisconnectWhenCompute(nodeName);\n                            resourceList.remove(nodeName);\n                            logger.debug(\n                                    \"initializeServerHandler.ServerLifecycleHandler: Removed resource for node: {}\",\n                                    nodeName);\n                            updateResource();\n                        } else {\n                            logger.debug(\n                                    \"initializeServerHandler.ServerLifecycleHandler: Disconnected channel was not a registered client: {}\",\n                                    ctx.channel());\n                        }\n                        super.channelInactive(ctx);\n                    }\n\n                    @Override\n                    public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                        logger.error(\n                                \"initializeServerHandler.ServerLifecycleHandler: Exception caught in pipeline for channel {}: {}\",\n                                ctx.channel(), cause.getMessage(), cause);\n                        ctx.close();\n                    }\n                });\n\n                channel.pipeline().addLast(\"ResourceUpdateMessageHandler\",\n                        new SimpleChannelInboundHandler<ResourceUpdateMessage>() {\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, ResourceUpdateMessage msg) {\n                                logger.debug(\n                                        \"initializeServerHandler.ResourceUpdateMessageHandler: Received ResourceUpdateMessage from {}: {}\",\n                                        ctx.channel().remoteAddress(), msg);\n                                if (network.getClients().containsKey(ctx.channel())) {\n                                    String nodeName = network.getClients().get(ctx.channel()).getKey();\n                                    logger.info(\"{} update resource {}\", nodeName, msg.getResource());\n                                    resourceList.put(nodeName, msg.getResource());\n                                    logger.info(\"now All Resource : {}\", getAllResource());\n                                    logger.debug(\n                                            \"initializeServerHandler.ResourceUpdateMessageHandler: Updated resource for node: {}. All resources: {}\",\n                                            nodeName, getAllResource());\n                                } else {\n                                    logger.warn(\n                                            \"initializeServerHandler.ResourceUpdateMessageHandler: Received ResourceUpdateMessage from unknown channel: {}\",\n                                            ctx.channel());\n                                }\n\n                                if (network.getBrokerChannel() != null) {\n                                    logger.debug(\n                                            \"initializeServerHandler.ResourceUpdateMessageHandler: Forwarding ResourceUpdateMessage to upstream broker: {}\",\n                                            network.getBrokerChannel());\n                                    network.getBrokerChannel()\n                                            .writeAndFlush(new ResourceUpdateMessage(getAllResource()));\n                                }\n                            }\n\n                            @Override\n                            public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                                logger.error(\n                                        \"initializeServerHandler.ResourceUpdateMessageHandler: Exception caught for channel {}: {}\",\n                                        ctx.channel(), cause.getMessage(), cause);\n                                ctx.close();\n                            }\n                        });\n\n                channel.pipeline().addLast(fileTransferHandler); // Assuming fileTransferHandler has its own logging or\n                // is tested separately\n\n                channel.pipeline().addLast(\"TaskFinishMessageHandler\",\n                        new SimpleChannelInboundHandler<TaskFinishMessage>() {\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, TaskFinishMessage msg) {\n                                logger.debug(\n                                        \"initializeServerHandler.TaskFinishMessageHandler: Received TaskFinishMessage from {}: {}\",\n                                        ctx.channel().remoteAddress(), msg);\n                                String clientName = network.getClients().get(ctx.channel()).getKey();\n                                if (clientName != null) {\n                                    taskResultList.put(clientName, msg.getAttachment());\n                                    logger.info(\"{} : end task\", clientName);\n                                    logger.debug(\n                                            \"initializeServerHandler.TaskFinishMessageHandler: Stored task result for client: {}. Result: {}\",\n                                            clientName, msg.getAttachment());\n                                } else {\n                                    logger.warn(\n                                            \"initializeServerHandler.TaskFinishMessageHandler: Received TaskFinishMessage from unknown client channel: {}\",\n                                            ctx.channel());\n                                }\n                            }\n\n                            @Override\n                            public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                                logger.error(\n                                        \"initializeServerHandler.TaskFinishMessageHandler: Exception caught for channel {}: {}\",\n                                        ctx.channel(), cause.getMessage(), cause);\n                                ctx.close();\n                            }\n                        });\n                channel.pipeline().addLast(\"WaitingRequestMessageHandler\",\n                        new SimpleChannelInboundHandler<WaitingRequestMessage>() {\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, WaitingRequestMessage msg) {\n                                logger.info(\n                                        \"WaitingRequestMessageHandler: *** RECEIVED WaitingRequestMessage *** from {}: RequestName: {}\",\n                                        ctx.channel().remoteAddress(), msg.getRequestName());\n                                logger.debug(\n                                        \"initializeServerHandler.WaitingRequestMessageHandler: Received WaitingRequestMessage from {}: RequestName: {}\",\n                                        ctx.channel().remoteAddress(), msg.getRequestName());\n\n                                logger.info(\n                                        \"WaitingRequestMessageHandler: Channel details - ID: {}, Local: {}, Remote: {}\",\n                                        ctx.channel().id(),\n                                        ctx.channel().localAddress(),\n                                        ctx.channel().remoteAddress());\n\n                                // 使用 requestName + timestamp 作為唯一的 key，避免重複的 requestName 覆蓋\n                                // channel\n                                String requestKey = msg.getRequestName();\n\n                                // 如果已經存在相同的 requestName，為避免覆蓋，使用 channel ID 作為後綴\n                                if (requestResultWaiterList.containsKey(requestKey)) {\n                                    requestKey = requestKey + \"_\"\n                                            + ctx.channel().id().asShortText();\n                                    logger.warn(\"Duplicate requestName detected: {}. Using unique key: {}\",\n                                            msg.getRequestName(), requestKey);\n                                }\n\n                                requestResultWaiterList.put(requestKey, ctx.channel());\n                                logger.info(\"waiting list update : {}\", requestResultWaiterList);\n                                logger.debug(\n                                        \"initializeServerHandler.WaitingRequestMessageHandler: Updated requestResultWaiterList for requestKey: {}. Channel: {}\",\n                                        requestKey, ctx.channel());\n\n                                // Update the originalRequestInformationMap with the actual requestKey used\n                                Map<String, Object> originalRequestInfo = originalRequestInformationMap.get(\n                                        msg.getRequestName());\n                                if (originalRequestInfo != null) {\n                                    originalRequestInfo.put(\"requestKey\", requestKey);\n                                    logger.debug(\n                                            \"initializeServerHandler.WaitingRequestMessageHandler: Updated original request info with actual requestKey: {}. RequestName: {}\",\n                                            requestKey, msg.getRequestName());\n                                }\n                            }\n\n                            @Override\n                            public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws Exception {\n                                logger.error(\n                                        \"initializeServerHandler.WaitingRequestMessageHandler: Exception caught for channel {}: {}\",\n                                        ctx.channel(), cause.getMessage(), cause);\n                                ctx.close();\n                            }\n                        });\n\n                channel.pipeline().addLast(\"RegisteMessageHandler\",\n                        new SimpleChannelInboundHandler<RegisteMessage>() { // 節點向仲介者註冊運算需求\n\n                            @SuppressWarnings(\"unchecked\") // For the cast of brokerRoute\n                            @Override\n                            protected void channelRead0(ChannelHandlerContext ctx, RegisteMessage msg)\n                                    throws Exception {\n                                logger.debug(\n                                        \"initializeServerHandler.RegisteMessageHandler: Received RegisteMessage from {}: RequestName: {}, ServiceName: {}\",\n                                        ctx.channel().remoteAddress(), msg.getRequestName(),\n                                        msg.getRequestInformation().get(\"serviceName\"));\n                                Map<String, Object> requestInformation = msg.getRequestInformation();\n                                String requestName = (String) requestInformation.get(\"requestName\");\n                                String serviceName = (String) requestInformation.get(\"serviceName\");\n                                HiBAService service = getService(serviceName);\n                                if (service == null)